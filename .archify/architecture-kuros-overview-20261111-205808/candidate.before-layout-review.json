  "cards": [
    {
      "dot": "cyan",
      "title": "请求先分清归属",
      "items": [
        "浏览器请求统一先进入 Gateway。",
        "认证与关注路由进入 kuros-user。",
        "其余业务进入 kuros-backend；作者信息再由 Feign 回查用户服务。"
      ]
    },
    {
      "dot": "emerald",
      "title": "共享状态各司其职",
      "items": [
        "MySQL 是用户、内容和互动关系的权威记录。",
        "Redis 保存跨实例共享的会话、权限、缓存、互动计数与 Feed ZSet。",
        "媒体文件进入本地卷或 MinIO，搜索索引进入 Elasticsearch。"
      ]
    },
    {
      "dot": "amber",
      "title": "异步链路",
      "items": [
        "点赞收藏先更新 Redis，再把事件发布到 RocketMQ。",
        "消费者按 postId 顺序投影到 MySQL；投递失败时写路径可同步降级。",
        "Canal 读取 MySQL binlog，经 RocketMQ 通知 backend 更新 ES 索引。"
      ]
    }
  ]
