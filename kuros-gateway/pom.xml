<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>com.kuros</groupId>
    <artifactId>kuros-gateway</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>kuros-gateway</name>
    <description>kuros-gateway</description>
    <properties>
        <java.version>21</java.version>
        <!-- 与 kuros-backend 保持一致的 Testcontainers 2.x（1.x 与 Docker Engine 29 不兼容） -->
        <testcontainers.version>2.0.5</testcontainers.version>
    </properties>

    <!-- 双 BOM 与 kuros-backend 完全一致：版本组合（Boot 4.1.1 + SC 2025.1.1 + SCA 2025.1.0.0）
         已由切片 #8 的集成测试实测验证，gateway 工程直接复用该赌注结论 -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>2025.1.1</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.alibaba.cloud</groupId>
                <artifactId>spring-cloud-alibaba-dependencies</artifactId>
                <version>2025.1.0.0</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Spring Cloud Gateway Server WebFlux：网关核心。
             4.3 起 starter 改名（旧 spring-cloud-starter-gateway 已过时），WebFlux 与 MVC 栈拆分；
             网关基于 WebFlux/Netty，无法嵌入 Servlet 后端，必须独立容器 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-gateway-server-webflux</artifactId>
        </dependency>
        <!-- lb:// 路由的负载均衡实现：Spring Cloud LoadBalancer，lb: 前缀的 uri 依赖它解析服务实例 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>
        <!-- Nacos 服务发现：网关自身注册为 kuros-gateway，并通过服务名发现 kuros-backend -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <!-- Nacos 配置中心：optional:nacos 分层导入（与 backend 同款模式，Q12 决策） -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>
        <!-- Actuator：仅暴露 health + prometheus 白名单（Q9 决策），供 compose healthcheck 与指标采集 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- Prometheus 指标注册表：白名单里的 /actuator/prometheus 端点由它提供，
             Boot 4 的 actuator starter 不再传递注册表实现，缺了它该端点 404 -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <version>${testcontainers.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
