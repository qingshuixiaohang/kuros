# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/front/node_modules
**/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.compose-smoke-state.json

# next.js
/front/.next/
/front/out/
/front/.playwright-cli/
/front/output/

# production
/front/build

# misc
.DS_Store
*.pem

# IDE metadata（.idea/* 默认忽略，但共享 maven.xml 让 IDEA 打开仓库即自动
# 识别三个 Maven 工程——JetBrains 官方支持的"共享项目结构"做法）
.idea/*
*.iml
!.idea/maven.xml

# backend build output
/kuros-backend/target/
/kuros-backend/storage/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
/front/.env*
/.env
/.env.*
!/.env.example
!/.env.production.example

# vercel
/front/.vercel

# typescript
*.tsbuildinfo
/front/next-env.d.ts
