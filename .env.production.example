# Replace every empty value before using this file for a deployed environment.
FRONTEND_PORT=3000
BACKEND_PORT=8080
MYSQL_PORT=3306

MYSQL_DATABASE=kuros
MYSQL_USER=kuros
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

NEXT_PUBLIC_API_BASE_URL=https://api.example.com
APP_CORS_ALLOWED_ORIGIN=https://www.example.com
APP_STORAGE_LOCAL_DIR=/app/storage
APP_STORAGE_PUBLIC_BASE_URL=https://api.example.com

APP_AUTH_DEV_CODE=
APP_AUTH_DEV_CODE_EXPOSED=false
APP_AUTH_SESSION_COOKIE_SECURE=true

# Internal API shared secret. Required in production: kuros-user rejects every
# /internal/** request without a matching X-Internal-Token header (fail-closed),
# so backend-to-user calls break until this is filled with the same value on both.
APP_INTERNAL_TOKEN=

# Swagger UI 和 API 文档在生产环境必须关闭（安全风险）
SPRINGDOC_ENABLED=false
