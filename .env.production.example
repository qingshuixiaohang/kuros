# Replace every placeholder before using this file for a deployed environment.
FRONTEND_PORT=3000
GATEWAY_PORT=8080
BACKEND_PORT=8090
USER_PORT=8091
MYSQL_PORT=3306

MYSQL_DATABASE=kuros
MYSQL_USER=kuros
MYSQL_PASSWORD=REPLACE_WITH_PRODUCTION_DATABASE_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_WITH_PRODUCTION_DATABASE_ROOT_PASSWORD

NEXT_PUBLIC_API_BASE_URL=https://api.example.com
APP_CORS_ALLOWED_ORIGIN=https://www.example.com
APP_STORAGE_LOCAL_DIR=/app/storage
APP_STORAGE_PUBLIC_BASE_URL=https://api.example.com
NEXT_SERVER_MEDIA_BASE_URL=https://api.example.com

APP_STORAGE_TYPE=minio
APP_STORAGE_MINIO_ACCESS_KEY=REPLACE_WITH_PRODUCTION_MINIO_ACCESS_KEY
APP_STORAGE_MINIO_SECRET_KEY=REPLACE_WITH_PRODUCTION_MINIO_SECRET_KEY

APP_AUTH_DEV_CODE=
APP_AUTH_DEV_CODE_EXPOSED=false
APP_AUTH_SESSION_COOKIE_SECURE=true
USER_SPRING_PROFILES_ACTIVE=production
BACKEND_SPRING_PROFILES_ACTIVE=production

# Production is intentionally blocked until a real SmsSender adapter is supplied.
# DevSmsSender is never loaded in production. See docs/roadmap/current-status.md.

# Internal API shared secret. Required in production: kuros-user rejects every
# /internal/** request without a matching X-Internal-Token header (fail-closed),
# so backend-to-user calls break until this is filled with the same value on both.
APP_INTERNAL_TOKEN=REPLACE_WITH_LONG_RANDOM_INTERNAL_TOKEN

# Swagger UI 和 API 文档在生产环境必须关闭（安全风险）
SPRINGDOC_ENABLED=false
