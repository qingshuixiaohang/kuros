<component name="ProjectRunConfigurationManager">
  <!-- 后端内容服务（帖子/评论/互动/搜索/媒体）。开发模式从 IDEA 裸跑，
       连 localhost:3307 的 Docker MySQL 与其他中间件；SERVER_PORT 用 8090
       避免与 gateway 的 8080 冲突（容器模式下 compose 网络隔离无需此变量）。 -->
  <configuration default="false" name="backend :8090" type="Application" factoryName="Application">
    <option name="MAIN_CLASS_NAME" value="com.kuros.kurosbackend.KurosBackendApplication" />
    <module name="kuros-backend" />
    <option name="VM_PARAMETERS" value="-Dfile.encoding=UTF-8 -Xmx640m -Xms256m -XX:MaxMetaspaceSize=288m" />
    <env name="SERVER_PORT" value="8090" />
    <method v="2">
      <option name="Make" enabled="true" />
    </method>
  </configuration>
</component>
