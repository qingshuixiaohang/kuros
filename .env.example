# Docker Compose ports
FRONTEND_PORT=3000
# 切片 #9 起 8080 正门归 gateway，backend 调试直连挪至 8090
GATEWAY_PORT=8080
BACKEND_PORT=8090
# 切片 #10 split-05 起 user 服务的宿主直连端口，容器内仍是 8080
USER_PORT=8091
MYSQL_PORT=3307
REDIS_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# MySQL development credentials only; replace them outside local development.
MYSQL_DATABASE=kuros
MYSQL_USER=kuros
MYSQL_PASSWORD=kuros_dev_password
MYSQL_ROOT_PASSWORD=kuros_dev_root_password

# Browser-visible API address. This is baked into the Next.js client bundle.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
APP_CORS_ALLOWED_ORIGIN=http://localhost:3000
APP_STORAGE_PUBLIC_BASE_URL=http://localhost:8080
APP_STORAGE_LOCAL_DIR=/app/storage

# Storage strategy: local (default) or minio
# 本地开发用 local（文件存磁盘，调试方便），生产环境切 minio（分布式、高可用）
APP_STORAGE_TYPE=local

# MinIO configuration (only used when APP_STORAGE_TYPE=minio)
# endpoint 本地开发用 localhost，compose 环境用 minio（服务名）
APP_STORAGE_MINIO_ENDPOINT=http://localhost:9000
APP_STORAGE_MINIO_ACCESS_KEY=minioadmin
APP_STORAGE_MINIO_SECRET_KEY=minioadmin
APP_STORAGE_MINIO_BUCKET=kuros-media

# Development login behavior. Fill in a local code only when you need the demo login.
APP_AUTH_DEV_CODE=
APP_AUTH_DEV_CODE_EXPOSED=false
APP_AUTH_SESSION_COOKIE_SECURE=false

# Redis (SaToken session + verification code + permission cache)
REDIS_HOST=localhost
REDIS_PASSWORD=

# 切片 #14：全文检索（Elasticsearch + ik）+ CDC（Canal）
# ES 宿主端口（容器内恒为 9200）；backend 经 compose 服务名 elasticsearch:9200 连接
ES_PORT=9200
ES_TRANSPORT_PORT=9300
# Kibana 观测面端口（仅 --profile observability 启动时用）
KIBANA_PORT=5601
# Canal server 端口（TCP，客户端直连用；本切片 canal 经 RocketMQ 投递，11111 仅健康/调试）
CANAL_PORT=11111
# ES 自建镜像的国内拉取兜底：docker.elastic.co / get.infini.cloud 不畅时，覆盖为可用镜像源
# （ik 版本必须与 ES 严格等版本，两个变量要同步改；默认留空即用官方源，与 se-01 spike 一致）
# ES_BASE_IMAGE=docker.elastic.co/elasticsearch/elasticsearch:9.4.5
# IK_PLUGIN_URL=https://get.infini.cloud/elasticsearch/analysis-ik/9.4.5
# KIBANA_IMAGE=docker.elastic.co/kibana/kibana:9.4.5
