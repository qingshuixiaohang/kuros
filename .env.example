# Docker Compose ports
FRONTEND_PORT=3000
BACKEND_PORT=8080
MYSQL_PORT=3307

# MySQL development credentials only; replace them outside local development.
MYSQL_DATABASE=kuros
MYSQL_USER=kuros
MYSQL_PASSWORD=kuros_dev_password
MYSQL_ROOT_PASSWORD=kuros_dev_root_password

# Browser-visible API address. This is baked into the Next.js client bundle.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
APP_CORS_ALLOWED_ORIGIN=http://localhost:3000
APP_STORAGE_PUBLIC_BASE_URL=http://localhost:8080
APP_STORAGE_LOCAL_DIR=/app/storage

# Development login behavior. Fill in a local code only when you need the demo login.
APP_AUTH_DEV_CODE=
APP_AUTH_DEV_CODE_EXPOSED=false
APP_AUTH_SESSION_COOKIE_SECURE=false
